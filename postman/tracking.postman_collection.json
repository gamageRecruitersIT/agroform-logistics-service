{
  "info": {
    "name": "Logistics - Delivery Tracking (Dilum)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 'Setup' first, set taskCode (e.g. TTK-AB12CD34) to a task that belongs to {{transporterId}}/{{driverId}}/{{farmerId}}. Run folders in order."
  },
  "item": [
    {
      "name": "Setup - mint test tokens (dev only)",
      "item": [
        {
          "name": "Transporter token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/test/token?role=TRANSPORTER&userId={{transporterId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "token"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "TRANSPORTER"
                },
                {
                  "key": "userId",
                  "value": "{{transporterId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('transporterToken', pm.response.json().data);"
                ]
              }
            }
          ]
        },
        {
          "name": "Driver token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/test/token?role=DRIVER&userId={{driverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "token"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "DRIVER"
                },
                {
                  "key": "userId",
                  "value": "{{driverId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('driverToken', pm.response.json().data);"
                ]
              }
            }
          ]
        },
        {
          "name": "Farmer token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/test/token?role=FARMER&userId={{farmerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "token"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "FARMER"
                },
                {
                  "key": "userId",
                  "value": "{{farmerId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('farmerToken', pm.response.json().data);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
