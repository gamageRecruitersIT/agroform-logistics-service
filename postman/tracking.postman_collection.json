{
  "info": {
    "_postman_id": "agroform-receipt-service-collection",
    "name": "Agroform Order Payment Service - Receipt Module",
    "description": "Postman collection for testing Receipt generation, retrieval and PDF download.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Receipts",
      "item": [
        {
          "name": "01 - Generate Receipt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentId\": \"{{paymentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/receipt/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payment",
                "receipt",
                "generate"
              ]
            },
            "description": "Generate a receipt for a PAID order."
          },
          "response": []
        },
        {
          "name": "02 - Get Receipt By Code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/receipt/{{receiptCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payment",
                "receipt",
                "{{receiptCode}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 - Get Receipt By Order Code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/receipt/order/{{orderCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payment",
                "receipt",
                "order",
                "{{orderCode}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "04 - Download Receipt PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/receipt/{{receiptCode}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payment",
                "receipt",
                "{{receiptCode}}",
                "download"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.url.toString().includes('/receipt/generate')) {",
          "    pm.test('Receipt generated successfully', function () {",
          "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "    });",
          "",
          "    let json = {};",
          "    try {",
          "        json = pm.response.json();",
          "    } catch (e) {",
          "        return;",
          "    }",
          "",
          "    if (json.data && json.data.receiptCode) {",
          "        pm.collectionVariables.set('receiptCode', json.data.receiptCode);",
          "        console.log('Receipt Code:', json.data.receiptCode);",
          "    }",
          "}",
          "",
          "if (pm.request.url.toString().includes('/receipt/') && !pm.request.url.toString().includes('/generate')) {",
          "    pm.test('HTTP status is successful', function () {",
          "        pm.expect(pm.response.code).to.be.within(200, 299);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "a0000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "881cdeed-5862-4750-a359-4d4c12ab2a48",
      "type": "string"
    },
    {
      "key": "receiptCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderCode",
      "value": "",
      "type": "string"
    }
  ]
}
